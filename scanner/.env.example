# --- Binance endpoints (free public APIs, no key needed) ---
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_SPOT_URL=https://api.binance.com

# --- Discord ---
DISCORD_WEBHOOK=https://discord.com/api/webhooks/XXXX/YYYY

# --- Core thresholds ---
PRICE_THRESHOLD=1.0        # minimum |price move| in percent
FUNDING_THRESHOLD=20.0     # minimum |funding quotient| in percent

# --- Scheduling ---
TOP_COINS=10
SCAN_INTERVAL=300          # seconds (5 minutes)
TOP_REFRESH=3600           # seconds (1 hour)
SPOT_REFRESH=21600         # seconds (6 hours)
ALERT_COOLDOWN=1800        # seconds (30 minutes) per-symbol dedupe

# --- Infrastructure ---
DB_PATH=scanner.db
LOG_LEVEL=INFO
MAX_CONCURRENCY=8

# --- Bonus: open interest filter ---
OI_FILTER_ENABLED=false
OI_PERIOD=5m
OI_LOOKBACK=6
OI_THRESHOLD=0.0           # minimum OI increase (%) required to confirm

# --- Bonus: funding history chart attached to alerts ---
CHART_ENABLED=true
CHART_POINTS=48

# --- Bonus: top funding movers leaderboard ---
LEADERBOARD_ENABLED=false
LEADERBOARD_INTERVAL=3600
LEADERBOARD_SIZE=5

# --- Bonus: Telegram alerts (leave empty to disable) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Bonus: Prometheus metrics ---
METRICS_ENABLED=false
METRICS_PORT=9109
